// DinkUp — Pickleball court booking & open games for Chandigarh tricity

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums For Module 1 (Auth)
// ─────────────────────────────────────────────

enum Role {
  PLAYER
  HOST
  ADMIN
}

// ─────────────────────────────────────────────
// Enums For Module 2 Venues & Courts
// ─────────────────────────────────────────────

enum TricityCity {
  CHANDIGARH
  MOHALI
  PANCHKULA
  ZIRAKPUR
}

enum CourtSurface {
  ACRYLIC_HARD
  CUSHIONED_ACRYLIC
  SYNTHETIC_TURF
  WOODEN
  CONCRETE
}

enum CourtType {
  INDOOR
  OUTDOOR
  COVERED_ROOFTOP
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  REFUND_PENDING
  REFUNDED
  FAILED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  OPEN
}

enum GameStatus {
  OPEN
  FULL
  CANCELLED
}

enum GameSeatStatus {
  HELD
  CONFIRMED
  RELEASED
}

// ─────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  phone    String? @unique
  password String // argon2 hash
  name     String
  role     Role // chosen at registration — PLAYER or HOST, never self-assigned ADMIN

  isActive  Boolean  @default(true) @map("is_active") // soft-disable accounts
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  venues       Venue[]
  slots        Slot[]
  bookings     Booking[]
  payments     Payment[]
  createdGames Game[]     @relation("GameCreator")
  gameSeats    GameSeat[]

  @@map("tbl_user")
}

// ─────────────────────────────────────────────
// Venues & Courts Models
// ─────────────────────────────────────────────

model Venue {
  id          Int     @id @default(autoincrement())
  hostId      Int     @map("host_id")
  name        String
  slug        String  @unique
  description String?

  // Location
  city          TricityCity
  area          String // e.g. "Sector 8", "Phase 7", "VIP Road"
  address       String
  googleMapsUrl String?     @map("google_maps_url")
  latitude      Float?
  longitude     Float?

  // Pickleball-specific amenities
  hasLighting        Boolean @default(true) @map("has_lighting")
  hasEquipmentRental Boolean @default(false) @map("has_equipment_rental")
  hasParking         Boolean @default(true) @map("has_parking")
  hasWashroom        Boolean @default(true) @map("has_washroom")
  hasDrinkingWater   Boolean @default(true) @map("has_drinking_water")

  // Contact Info (Front desk / Court manager)
  contactPhone   String? @map("contact_phone") // Front desk / manager mobile
  whatsappNumber String? @map("whatsapp_number") // For 1-tap "Chat on WhatsApp"
  contactEmail   String? @map("contact_email") // Optional public support email

  // Cancellation policy (hours before slot for free cancellation)
  cancellationCutoffHours Int @default(6) @map("cancellation_cutoff_hours")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  host     User         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  courts   Court[]
  images   VenueImage[]
  bookings Booking[]
  games    Game[]

  @@index([city, area])
  @@map("tbl_venue")
}

model VenueImage {
  id           Int      @id @default(autoincrement())
  venueId      Int      @map("venue_id")
  url          String
  isCover      Boolean  @default(false) @map("is_cover")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("tbl_venue_image")
}

model Court {
  id      Int          @id @default(autoincrement())
  venueId Int          @map("venue_id")
  name    String // e.g. "Court 1 (Centre Court)"
  surface CourtSurface @default(CUSHIONED_ACRYLIC)
  type    CourtType    @default(OUTDOOR)

  // Pricing in INR (e.g. 600 = ₹600/hour)
  basePricePerHour Int @map("base_price_per_hour")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  schedules Schedule[]
  slots     Slot[]
  bookings  Booking[]
  games     Game[]

  @@map("tbl_court")
}

model Schedule {
  id                  Int       @id @default(autoincrement())
  courtId             Int       @map("court_id")
  dayOfWeek           DayOfWeek @map("day_of_week")
  openTime            String    @map("open_time") // "06:00" (24h format)
  closeTime           String    @map("close_time") // "23:00" (24h format)
  slotDurationMinutes Int       @default(60) @map("slot_duration_minutes")
  priceOverride       Int?      @map("price_override") // Optional custom price for this day (e.g. weekend pricing)

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, dayOfWeek])
  @@map("tbl_schedule")
}

model Slot {
  id        Int        @id @default(autoincrement())
  courtId   Int        @map("court_id")
  date      DateTime   @db.Date
  startTime String     @map("start_time") // "06:00"
  endTime   String     @map("end_time") // "07:00"
  price     Int // Price in INR for this slot
  status    SlotStatus @default(AVAILABLE)

  // 5-Minute Hold Fields
  heldBy        Int?      @map("held_by") // User ID of the player holding the slot
  holdExpiresAt DateTime? @map("hold_expires_at")
  version       Int       @default(0) // Optimistic concurrency row counter

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  court    Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  holder   User?     @relation(fields: [heldBy], references: [id], onDelete: SetNull)
  bookings Booking[]

  // Enforce no duplicate slot times for the same court on the same date
  @@unique([courtId, date, startTime])
  @@index([courtId, date])
  @@map("tbl_slot")
}

// ─────────────────────────────────────────────
// Module 4: Bookings
// ─────────────────────────────────────────────

model Booking {
  id               Int           @id @default(autoincrement())
  bookingReference String        @unique @map("booking_reference") // e.g. "DNK-261027-9X4A"
  userId           Int           @map("user_id")
  slotId           Int           @map("slot_id")
  courtId          Int           @map("court_id")
  venueId          Int           @map("venue_id")
  status           BookingStatus @default(PENDING)

  totalPrice Int @map("total_price") // INR price locked at checkout

  cancellationCutoff DateTime? @map("cancellation_cutoff")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelReason       String?   @map("cancel_reason")

  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot     Slot      @relation(fields: [slotId], references: [id], onDelete: Restrict)
  court    Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  payments Payment[]
  game     Game?

  @@index([userId])
  @@index([slotId])
  @@index([venueId])
  @@index([status])
  @@map("tbl_booking")
}

// ─────────────────────────────────────────────
// Module 5: Payments & Webhook Deduplication
// ─────────────────────────────────────────────

model Payment {
  id               Int             @id @default(autoincrement())
  paymentReference String          @unique @map("payment_reference") // e.g. "PAY-261030-9X4A"
  bookingId        Int             @map("booking_id")
  userId           Int             @map("user_id")
  provider         PaymentProvider @default(MOCK)
  orderId          String          @map("order_id") // Gateway order ID (e.g. order_mock_xxx or order_xxx)
  paymentId        String?         @map("payment_id") // Gateway payment ID (e.g. pay_xxx)
  signature        String?
  amount           Int // Total amount in INR
  currency         String          @default("INR")
  status           PaymentStatus   @default(CREATED)
  refundId         String?         @map("refund_id")
  refundReason     String?         @map("refund_reason")
  idempotencyKey   String?         @map("idempotency_key")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("tbl_payment")
}

model WebhookEvent {
  id          Int             @id @default(autoincrement())
  eventId     String          @unique @map("event_id") // Gateway event ID for deduplication
  provider    PaymentProvider @default(MOCK)
  eventType   String          @map("event_type") // e.g. "payment.captured", "payment.failed"
  payload     Json
  processedAt DateTime        @default(now()) @map("processed_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("tbl_webhook_event")
}

// ─────────────────────────────────────────────
// Module 6: Open Games
// ─────────────────────────────────────────────

model Game {
  id           Int        @id @default(autoincrement())
  bookingId    Int        @unique @map("booking_id")
  creatorId    Int        @map("creator_id")
  courtId      Int        @map("court_id")
  venueId      Int        @map("venue_id")
  title        String?
  description  String?
  skillLevel   SkillLevel @default(OPEN) @map("skill_level")
  seatsTotal   Int        @default(4) @map("seats_total")
  seatsTaken   Int        @default(1) @map("seats_taken")
  pricePerSeat Int        @map("price_per_seat")
  status       GameStatus @default(OPEN)
  version      Int        @default(0) // Optimistic row version
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  booking Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  creator User       @relation("GameCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  court   Court      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  venue   Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats   GameSeat[]

  @@index([venueId])
  @@index([courtId])
  @@index([creatorId])
  @@index([status])
  @@index([skillLevel])
  @@map("tbl_game")
}

model GameSeat {
  id            Int            @id @default(autoincrement())
  gameId        Int            @map("game_id")
  userId        Int            @map("user_id")
  seatNumber    Int            @map("seat_number") // 1 (creator), 2, 3, 4
  price         Int            @map("price")
  status        GameSeatStatus @default(HELD)
  holdExpiresAt DateTime?      @map("hold_expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId]) // 1 seat per player in a game
  @@unique([gameId, seatNumber]) // No duplicate seat numbers in a game
  @@index([gameId])
  @@index([userId])
  @@index([status])
  @@map("tbl_game_seat")
}
