# Used by the running NestJS application
DATABASE_URL="your-neon-pooled-connection-string"

# Used by Prisma CLI for migrations
DIRECT_URL="your-neon-direct-connection-string"

# Auth
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Cloudflare R2 / S3 Storage (Optional: falls back to local disk /uploads if empty)
S3_ENDPOINT="https://<your-account-id>.r2.cloudflarestorage.com"
S3_BUCKET="dinkup-venues"
S3_ACCESS_KEY="your-r2-access-key-id"
S3_SECRET_KEY="your-r2-secret-access-key"
S3_PUBLIC_URL="https://pub-<your-hash>.r2.dev"

# Redis (BullMQ queues & background workers)
REDIS_URL="redis://localhost:6379"
